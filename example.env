# Copy this file to .env and fill in your values. Never commit .env.
# Load it with: node --env-file=.env your-script.js

# Required. Get a key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your-api-key-here

# Optional. Jev model to use (default: jev-latest)
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. API root (default: https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional. debug | info | warn | error | off (default: warn)
# TYPESAFE_LOG_LEVEL=warn
